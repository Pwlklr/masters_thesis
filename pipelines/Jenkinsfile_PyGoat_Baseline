pipeline {
    agent any

    options {
        // Disable concurrent builds to ensure accurate time measurements
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Fetch Ground Truth') {
            steps {
                script {
                    echo "Copying PyGoat from local isolated environment to avoid network latency..."
                }
                // Copying from your local apps folder into the Jenkins workspace
                sh 'rsync -a /home/pwlklr/masters_thesis/apps/pygoat/ ./'
            }
        }

        stage('Build Container Image') {
            steps {
                script {
                    echo "Building the baseline PyGoat Docker image..."
                }
                // Build the image without any security gates
                sh 'docker build -t pygoat-benchmark:latest .'
            }
        }
    }

    post {
        always {
            // Clean up the workspace so the next run starts fresh
            cleanWs()
            // Clean up the built image to prevent Docker cache from skewing time measurements
            sh 'docker rmi pygoat-benchmark:latest || true'
        }
    }
}