pipeline {
    agent any

    options {
        // Disable concurrent builds to ensure accurate time measurements
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Fetch Ground Truth') {
            steps {
                script {
                    echo "Copying django.nV from local isolated environment to avoid network latency..."
                }
                // Copying from your local apps folder into the Jenkins workspace
                sh 'rsync -a /home/pwlklr/masters_thesis/apps/django.nV/ ./'
            }
        }

        stage('Build Container Image') {
            steps {
                script {
                    echo "Building the baseline django.nV Docker image..."
                }
                // Build the image without any security gates
                sh 'docker build -t djangonv-benchmark:latest .'
            }
        }
    }

    post {
        always {
            // Clean up the workspace so the next run starts fresh
            cleanWs()
            // Clean up the built image to prevent Docker cache from skewing time measurements
            sh 'docker rmi djangonv-benchmark:latest || true'
        }
    }
}