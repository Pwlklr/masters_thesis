pipeline {
    agent any

    options {
        // Disable concurrent builds to ensure accurate time measurements
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Fetch Ground Truth') {
            steps {
                script {
                    echo "Copying DVPWA from local isolated environment..."
                }
                // Copying from your local apps folder into the Jenkins workspace
                sh 'rsync -a /home/pwlklr/masters_thesis/apps/dvpwa/ ./'
            }
        }

        stage('Build Container Image') {
            steps {
                script { echo "Building the baseline DVPWA Docker compose stack..." }
                sh 'docker compose build'
            }
        }
    }

    post {
        always {
            cleanWs()
            // Clean up the specific compose images built for DVPWA
            sh 'docker rmi dvpwa-sqli:latest dvpwa-postgres:latest || true'
            sh 'docker system prune -f'
        }
    }
}