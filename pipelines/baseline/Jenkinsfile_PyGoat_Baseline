pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Fetch Ground Truth') {
            steps {
                script { echo "Copying PyGoat from local isolated environment..." }
                sh 'rsync -a /home/pwlklr/masters_thesis/apps/pygoat/ ./'
            }
        }

        stage('Build Container Image') {
            steps {
                script { echo "Building the baseline PyGoat Docker compose stack..." }
                sh 'docker compose build'
            }
        }
        
        stage('Deploy Stack') {
            steps {
                script { echo "Deploying stack to normalize baseline infrastructure time..." }
                sh 'docker compose up -d'
                
                // Dynamically poll the endpoint (Port 8000)
                sh '''#!/bin/bash
                endTime=$((SECONDS + 30))
                while [ $SECONDS -lt $endTime ]; do
                    code=$(curl -s -o /dev/null -w "%{http_code}" localhost:8000 || echo "000")
                    if [ "$code" = "200" ] || [ "$code" = "302" ] || [ "$code" = "404" ]; then
                        echo "Service is up (HTTP $code)"
                        break
                    fi
                    sleep 1
                done
                '''
            }
        }
    }

    post {
        always {
            sh 'docker compose down -v || true'
            cleanWs()
            sh 'docker system prune -a -f || true'
        }
    }
}